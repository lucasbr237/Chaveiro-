{
  "name": "chaveiro-rapido",
  "version": "1.0.0",
  "private": true,
  "description": "Chaveiro Rápido — app de chaves Pix, offline-first, empacotado com Capacitor",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./www/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./www/css/styles.css --watch",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "android:build": "npm run build:css && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capgo/capacitor-native-biometric": "^8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.4.0"
  }
}
